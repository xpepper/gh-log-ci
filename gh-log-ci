#!/usr/bin/env bash

set -euo pipefail

PROGRAM="gh log-ci"
VERSION="0.6.0"

show_help() {
  cat <<'EOF'
gh log-ci - show CI status next to recent commits

Usage:
  gh log-ci [options] [<branch>]

 Options:
   --branch <name>        Branch to inspect (alternative to positional <branch>)
   --limit, -n <n>        Number of commits to display (default: 15; env LOG_CI_LIMIT overrides)
   --checks, -C           Show per-check run summaries beneath each commit (env LOG_CI_SHOW_CHECKS=1)
   --no-spinner           Disable loading spinner (env LOG_CI_NO_SPINNER=1)
   --api-timeout <secs>   Max seconds per API request (default: 30; env LOG_CI_API_TIMEOUT)
   --watch                Continuously poll and update commit statuses
   --watch-interval <s>   Seconds between polls in watch mode (default: 10; env LOG_CI_WATCH_INTERVAL)
   --no-cache             Ignore success cache, force fresh API calls for all commits
   --help, -h             Show this help text
   --version              Show version

Branch auto-detect order when <branch> not supplied:
  1. GitHub default branch (via gh repo view)
  2. master (if exists)
  3. main (if exists)
  4. current HEAD branch

Examples:
  gh log-ci                                  # auto-detect branch
  gh log-ci main                             # explicit positional branch
  gh log-ci --branch develop --limit 30
  gh log-ci -n 50                            # show 50 commits
  LOG_CI_SHOW_CHECKS=1 gh log-ci -n 10       # show per-check summaries (env)
  gh log-ci -C --limit 5                     # show per-check summaries (flag)
  gh log-ci --watch                          # watch mode (poll every 10s)
  gh log-ci --watch --watch-interval 30      # watch mode with custom interval

Additional environment:
  LOG_CI_WATCH_INTERVAL   Override default poll interval (10)
  LOG_CI_WATCH_ONCE=1     Internal/testing: run only one watch iteration then exit

Exit codes:
  0 success
  1 setup or API error

EOF
}

# Default values (can be overridden by env or flags)
USER_BRANCH=""
LIMIT="${LOG_CI_LIMIT:-15}"
SHOW_CHECKS="${LOG_CI_SHOW_CHECKS:-0}"
NO_SPINNER="${LOG_CI_NO_SPINNER:-0}"
API_TIMEOUT="${LOG_CI_API_TIMEOUT:-30}"
WATCH=0
WATCH_INTERVAL="${LOG_CI_WATCH_INTERVAL:-10}"
CACHE_TTL="${LOG_CI_CACHE_TTL:-86400}" # seconds (default 24h)
CACHE_DIR="${LOG_CI_CACHE_DIR:-$HOME/.cache/gh-log-ci}"
CACHE_DEBUG="${LOG_CI_CACHE_DEBUG:-0}"
NO_CACHE=0

# Parse flags
POS_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --branch)
      USER_BRANCH="${2:-}"; shift || true
      ;;
    --limit|-n)
      LIMIT="${2:-}"; shift || true
      ;;
    --checks|-C)
      SHOW_CHECKS=1
      ;;
    --no-spinner)
      NO_SPINNER=1
      ;;
    --api-timeout)
      API_TIMEOUT="${2:-}"; shift || true
      ;;
    --watch)
      WATCH=1
      ;;
    --watch-interval)
      WATCH_INTERVAL="${2:-}"; shift || true
      ;;
    --no-cache)
      NO_CACHE=1
      ;;
    -h|--help)
      show_help; exit 0
      ;;
    --version)
      echo "$PROGRAM $VERSION"; exit 0
      ;;
    --) # end of flags
      shift; break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      echo "Run with --help for usage." >&2
      exit 1
      ;;
    *)
      POS_ARGS+=("$1")
      ;;
  esac
  shift || true
done

# If positional branch provided and no --branch flag, use it.
if [[ -z "$USER_BRANCH" && ${#POS_ARGS[@]} -ge 1 ]]; then
  USER_BRANCH="${POS_ARGS[0]}"
fi

# Validate numeric inputs
if ! [[ "$LIMIT" =~ ^[0-9]+$ ]] || [[ "$LIMIT" -le 0 ]]; then
  echo "Error: --limit must be a positive integer (got '$LIMIT')." >&2
  exit 1
fi
if ! [[ "$API_TIMEOUT" =~ ^[0-9]+$ ]] || [[ "$API_TIMEOUT" -le 0 ]]; then
  echo "Error: --api-timeout must be a positive integer (got '$API_TIMEOUT')." >&2
  exit 1
fi
if [[ "$WATCH" -eq 1 ]]; then
  if ! [[ "$WATCH_INTERVAL" =~ ^[0-9]+$ ]] || [[ "$WATCH_INTERVAL" -le 0 ]]; then
    echo "Error: --watch-interval must be a positive integer (got '$WATCH_INTERVAL')." >&2
    exit 1
  fi
fi

# Determine branch (BRANCH variable) using auto-detect if USER_BRANCH empty
if [[ -n "$USER_BRANCH" ]]; then
  BRANCH="$USER_BRANCH"
else
  GH_DEFAULT_BRANCH="$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name 2>/dev/null || true)"
  if [[ -n "${GH_DEFAULT_BRANCH}" ]]; then
    BRANCH="${GH_DEFAULT_BRANCH}"
  else
    if git show-ref --verify --quiet refs/heads/master || git ls-remote --exit-code origin master &>/dev/null; then
      BRANCH="master"
    elif git show-ref --verify --quiet refs/heads/main || git ls-remote --exit-code origin main &>/dev/null; then
      BRANCH="main"
    else
      BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo master)"
    fi
  fi
fi

# Detect remote URL for origin or fallback to first remote
REMOTE_URL=$(git remote get-url origin 2>/dev/null || git remote get-url "$(git remote | head -n1)" 2>/dev/null || true)
if [[ -z "${REMOTE_URL:-}" ]]; then
  echo "Error: Could not detect Git remote URL." >&2
  exit 1
fi

# Parse OWNER and REPO from GitHub remote URL (optional .git suffix)
if [[ "$REMOTE_URL" =~ github.com[:/]([^/]+)/([^/]+)(\.git)?$ ]]; then
  OWNER="${BASH_REMATCH[1]}"
  REPO="${BASH_REMATCH[2]}"
  REPO="${REPO%.git}"
else
  echo "Error: Remote URL is not a recognized GitHub URL." >&2
  exit 1
fi

# Now that OWNER/REPO known, finalize cache file path (was deferred until after parse)
CACHE_FILE="$CACHE_DIR/${OWNER}_${REPO}_success.cache"

# Ensure we have remote branch; fetch quietly, tolerate missing remote branch gracefully.
if git ls-remote --exit-code origin "$BRANCH" &>/dev/null; then
  git fetch origin "$BRANCH" --quiet
else
  echo "Warning: Remote branch '$BRANCH' not found on origin. Using local branch if available." >&2
fi

 # Build a format with: <plain SHA><TAB><colored pretty message>
# Use %x09 for a literal TAB (portable) so we can split safely.
FORMAT='%H%x09%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset'

run_with_timeout() {
  local _timeout="$1"; shift
  local _tmp_out
  _tmp_out="$(mktemp -t ghlogci_cmd.XXXX)"
  ("$@" > "$_tmp_out" 2>&1) &
  local _pid=$!
  local _elapsed=0
  while kill -0 "$_pid" 2>/dev/null; do
    if [[ $_elapsed -ge $_timeout ]]; then
      kill "$_pid" 2>/dev/null || true
      wait "$_pid" 2>/dev/null || true
      echo "__TIMEOUT__" > "$_tmp_out"
      break
    fi
    sleep 1
    _elapsed=$((_elapsed+1))
  done
  wait "$_pid" 2>/dev/null || true
  cat "$_tmp_out"
  rm -f "$_tmp_out" 2>/dev/null || true
}

fetch_check_runs_graphql() {
  local -n _shas=$1
  local -n _results=$2

  # Build GraphQL query for batch fetching commit statuses
  local query="{
    repository(owner: \"$OWNER\", name: \"$REPO\") {"

  local idx=0
  for sha in "${_shas[@]}"; do
    query+="
      commit${idx}: object(expression: \"${sha}\") {
        ... on Commit {
          oid
          statusCheckRollup {
            state
            contexts(last: 100) {
              nodes {
                ... on CheckRun {
                  name
                  status
                  conclusion
                }
                ... on StatusContext {
                  context
                  state
                }
              }
            }
          }
          checkSuites(first: 100) {
            nodes {
              checkRuns(first: 100) {
                nodes {
                  name
                  status
                  conclusion
                }
              }
            }
          }
        }
      }"
    idx=$((idx+1))
  done

  query+="
    }
  }"

  # Execute GraphQL query with timeout
  local gql_result
  gql_result=$(run_with_timeout "$API_TIMEOUT" gh api graphql \
    -f query="$query" 2>/dev/null || echo "__TIMEOUT__")

  if [[ "$gql_result" == "__TIMEOUT__" ]]; then
    return 1
  fi

  # Parse GraphQL response and populate results associative array
  # Format: results[SHA]="state|check_data"
  idx=0
  for sha in "${_shas[@]}"; do
    local commit_data
    commit_data=$(echo "$gql_result" | jq -r ".data.repository.commit${idx} // empty" 2>/dev/null)

    if [[ -z "$commit_data" || "$commit_data" == "null" ]]; then
      # No data for this commit, mark as unknown
      _results["$sha"]="UNKNOWN|"
      idx=$((idx+1))
      continue
    fi

    local rollup_state
    local check_details

    # Try statusCheckRollup first (preferred, has aggregated state)
    rollup_state=$(echo "$commit_data" | jq -r '.statusCheckRollup.state // empty' 2>/dev/null)

    if [[ -n "$rollup_state" && "$rollup_state" != "null" ]]; then
      # statusCheckRollup available, use it
      check_details=$(echo "$commit_data" | jq -r '
        .statusCheckRollup.contexts.nodes[]? |
        if .name then
          "\(.name)\t\(.status // "")\t\(.conclusion // "")"
        elif .context then
          "\(.context)\t\(.state)\t"
        else
          empty
        fi' 2>/dev/null || echo "")
    else
      # Fallback to checkSuites when statusCheckRollup is null
      rollup_state="UNKNOWN"
      check_details=$(echo "$commit_data" | jq -r '
        .checkSuites.nodes[]?.checkRuns.nodes[]? |
        "\(.name)\t\(.status // "")\t\(.conclusion // "")"' 2>/dev/null || echo "")

      # If we have check details from checkSuites, derive state from them
      if [[ -n "$check_details" ]]; then
        # Analyze check runs to determine overall state
        local has_failure has_pending has_success
        has_failure=$(echo "$check_details" | grep -i "FAILURE\|ACTION_REQUIRED\|TIMED_OUT" || true)
        has_pending=$(echo "$check_details" | grep -i "QUEUED\|IN_PROGRESS\|PENDING" || true)
        has_success=$(echo "$check_details" | grep -i "SUCCESS" || true)

        if [[ -n "$has_failure" ]]; then
          rollup_state="FAILURE"
        elif [[ -n "$has_pending" ]]; then
          rollup_state="PENDING"
        elif [[ -n "$has_success" ]]; then
          rollup_state="SUCCESS"
        fi
      fi
    fi

    _results["$sha"]="${rollup_state}|${check_details}"
    idx=$((idx+1))
  done

  return 0
}


run_once() {
  INDEX=0
  declare -A LINE_MAP
  declare -A SHA_MAP
  declare -A SUCCESS_CACHE
  # Determine ref to log: prefer origin/<branch> if it exists, else local branch
  LOG_REF="origin/$BRANCH"
  if ! git show-ref --verify --quiet "refs/remotes/$LOG_REF"; then
    # fallback to local branch name
    LOG_REF="$BRANCH"
  fi
  while IFS=$'\t' read -r SHA MESSAGE; do
    LINE_MAP[$INDEX]="$MESSAGE"
    SHA_MAP[$INDEX]="$SHA"
    INDEX=$((INDEX+1))
  done < <(git log "$LOG_REF" --color=always --pretty="$FORMAT" -n "$LIMIT")

  # Prepare cache (success-only)
  if [[ ! -d "$CACHE_DIR" ]]; then
    mkdir -p "$CACHE_DIR" 2>/dev/null || true
  fi
  NOW_EPOCH=$(date +%s)
  if [[ -f "$CACHE_FILE" ]]; then
    while IFS=$'\t' read -r C_SHA C_TS; do
      if [[ -n "$C_SHA" && -n "$C_TS" ]]; then
        AGE=$((NOW_EPOCH - C_TS))
        if [[ $AGE -lt $CACHE_TTL ]]; then
          SUCCESS_CACHE[$C_SHA]="$C_TS"
        fi
      fi
    done < "$CACHE_FILE"
  fi

  TOTAL=$INDEX
  TMPDIR=$(mktemp -d 2>/dev/null || mktemp -d -t ghlogci)

  spinner() {
    local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local i=0
    while :; do
      if [[ -f "$TMPDIR/.done" ]]; then
        COMPLETED=$(wc -l < "$TMPDIR/.done" 2>/dev/null || echo 0)
      else
        COMPLETED=0
      fi
      printf "\r%s Fetching CI statuses... %d/%d" "${frames[$i]}" "$COMPLETED" "$TOTAL"
      i=$(((i+1)%${#frames[@]}))
      sleep 0.1
    done
  }

  trap '[[ -n "${SPINNER_PID:-}" ]] && kill "$SPINNER_PID" 2>/dev/null || true' INT TERM
  if [[ "$NO_SPINNER" -ne 1 ]]; then
    spinner &
    SPINNER_PID=$!
  fi

  # Collect all SHAs for batch GraphQL query
  declare -a SHA_ARRAY
  for i in $(seq 0 $((TOTAL-1))); do
    SHA_ARRAY+=("${SHA_MAP[$i]}")
  done

  # Fetch all check runs via GraphQL batch query
  declare -A GRAPHQL_RESULTS
  if ! fetch_check_runs_graphql SHA_ARRAY GRAPHQL_RESULTS; then
    echo "Error: Failed to fetch check runs via GraphQL API" >&2
    exit 1
  fi

  # Process results for each commit
  for i in $(seq 0 $((TOTAL-1))); do
    SHA="${SHA_MAP[$i]}"

    # Cache hit: if commit is cached success and not showing checks and --no-cache not set, skip processing
    if [[ -n "${SUCCESS_CACHE[$SHA]:-}" && "$SHOW_CHECKS" != "1" && "$NO_CACHE" != "1" ]]; then
      if [[ "$CACHE_DEBUG" == "1" ]]; then
        echo "[cache hit] $SHA" >&2
      fi
      echo "✅  ${LINE_MAP[$i]}" > "$TMPDIR/$i"
      echo 1 >> "$TMPDIR/.done"
      continue
    fi

    # Parse GraphQL result for this commit
    RESULT_DATA="${GRAPHQL_RESULTS[$SHA]:-UNKNOWN|}"
    IFS='|' read -r ROLLUP_STATE CHECK_DATA <<< "$RESULT_DATA"

    success_count=0; fail_count=0; cancel_count=0; pending_count=0; other_count=0; total_count=0
    DETAIL_OUTPUT=""

    # Process individual check runs if data available
    if [[ -n "$CHECK_DATA" ]]; then
      while IFS=$'\t' read -r NAME STATUS CONCLUSION; do
        [[ -z "$NAME" ]] && continue
        total_count=$((total_count+1))
        ICON_RUN=""

        # Map GraphQL states to icons
        # For CheckRun: status (queued/in_progress/completed) + conclusion (success/failure/etc)
        # For StatusContext: state (pending/success/failure/error)
        if [[ -n "$CONCLUSION" ]]; then
          # CheckRun with conclusion
          if [[ "$CONCLUSION" == "success" ]]; then
            ICON_RUN="✅"; success_count=$((success_count+1))
          elif [[ "$CONCLUSION" =~ ^(failure|timed_out|action_required)$ ]]; then
            ICON_RUN="❌"; fail_count=$((fail_count+1))
          elif [[ "$CONCLUSION" == "cancelled" ]]; then
            ICON_RUN="🚫"; cancel_count=$((cancel_count+1))
          elif [[ "$CONCLUSION" =~ ^(neutral|skipped|stale)$ ]]; then
            ICON_RUN="➖"; other_count=$((other_count+1))
          else
            ICON_RUN="❔"; other_count=$((other_count+1))
          fi
        elif [[ -n "$STATUS" ]]; then
          # CheckRun without conclusion or StatusContext
          if [[ "$STATUS" =~ ^(queued|in_progress|pending)$ ]]; then
            ICON_RUN="🕓"; pending_count=$((pending_count+1))
          elif [[ "$STATUS" == "success" ]]; then
            ICON_RUN="✅"; success_count=$((success_count+1))
          elif [[ "$STATUS" =~ ^(failure|error)$ ]]; then
            ICON_RUN="❌"; fail_count=$((fail_count+1))
          else
            ICON_RUN="❔"; other_count=$((other_count+1))
          fi
        else
          ICON_RUN="❔"; other_count=$((other_count+1))
        fi

        if [[ "$SHOW_CHECKS" == "1" ]]; then
          SHORT_NAME="$NAME"
          [[ ${#SHORT_NAME} -gt 40 ]] && SHORT_NAME="${SHORT_NAME:0:37}..."
          DETAIL_OUTPUT+="    • $ICON_RUN $SHORT_NAME ($STATUS${CONCLUSION:+/$CONCLUSION})\n"
        fi
      done <<< "$CHECK_DATA"
    fi

    # Determine overall icon based on rollup state and individual counts
    OVERALL_ICON="❔"
    case "$ROLLUP_STATE" in
      SUCCESS)
        OVERALL_ICON="✅"
        ;;
      FAILURE|ERROR)
        OVERALL_ICON="❌"
        ;;
      PENDING)
        OVERALL_ICON="🕓"
        ;;
      EXPECTED)
        # EXPECTED means checks are expected but not yet run
        OVERALL_ICON="🕓"
        ;;
      *)
        # Fallback to count-based logic if rollup state is unknown
        if [[ $fail_count -gt 0 ]]; then
          OVERALL_ICON="❌"
        elif [[ $pending_count -gt 0 ]]; then
          OVERALL_ICON="🕓"
        elif [[ $cancel_count -gt 0 ]]; then
          OVERALL_ICON="🚫"
        elif [[ $success_count -gt 0 && $fail_count -eq 0 ]]; then
          OVERALL_ICON="✅"
        fi
        ;;
    esac

    {
      echo "$OVERALL_ICON  ${LINE_MAP[$i]}"
      if [[ "$SHOW_CHECKS" == "1" && -n "$DETAIL_OUTPUT" ]]; then
        printf "%b" "$DETAIL_OUTPUT"
      fi
    } > "$TMPDIR/$i"

    # Cache store: only add if overall success
    if [[ "$OVERALL_ICON" == "✅" ]]; then
      # Append SHA and timestamp if not already present
      if [[ -z "${SUCCESS_CACHE[$SHA]:-}" ]]; then
        echo -e "$SHA\t$NOW_EPOCH" >> "$CACHE_FILE"
      fi
    fi

    echo 1 >> "$TMPDIR/.done"
  done

  COMPLETED=$TOTAL
  if [[ -n "${SPINNER_PID:-}" && "$NO_SPINNER" -ne 1 ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    printf "\r%-60s\r" ""
  fi
  for i in $(seq 0 $((TOTAL-1))); do
    cat "$TMPDIR/$i" 2>/dev/null || echo "❔  ${LINE_MAP[$i]}"
  done
  rm -rf "$TMPDIR" 2>/dev/null || true
  echo
}

if [[ $WATCH -eq 1 ]]; then
  while :; do
    # Use clear with fallback to ANSI reset; suppress errors (CI may lack termcap)
    clear 2>/dev/null || printf '\033c'
    echo "[watch] $(date '+%Y-%m-%d %H:%M:%S') branch=$BRANCH interval=${WATCH_INTERVAL}s limit=$LIMIT"
    run_once
    if [[ "${LOG_CI_WATCH_ONCE:-0}" == "1" ]]; then
      break
    fi
    sleep "$WATCH_INTERVAL"
  done
else
  run_once
fi
